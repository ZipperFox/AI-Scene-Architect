{
  "schema_version": "0.2",
  "id": "crystal-mine",
  "brief": "建立小型、低模風格的奇幻水晶礦洞，包含不規則洞穴岩壁、木製支架、不同大小的發光水晶、一輛廢棄礦車、散落礦石、入口與主要探索區域，燈光與構圖合理。",
  "scene_type": "Cutaway fantasy mining chamber",
  "style": "Low-poly, faceted mineral forms, restrained cool crystal glow and aged warm timber",
  "purpose": "Editable game environment diorama with a clear entrance and exploration route",
  "seed": 37,
  "art_direction": {
    "mood": [
      "幽靜",
      "粗獷",
      "微光"
    ],
    "focal_point": "後方右側三支高低錯落的青色晶簇；入口支架與軌道引導視線。",
    "palette_rationale": "冷灰岩壁、赭棕木材、氧化鐵灰礦車；青綠僅用於水晶焦點。",
    "assumptions": [
      "採用可檢視的剖面洞穴，前側與上方開放，以便遊戲鏡頭與俯視檢查；不是封閉的整座地下山體。",
      "範圍約 12×12 公尺，洞壁最高 4.4 公尺，人物參考通行高度 1.9 公尺。",
      "礦車留有空心料斗、四輪、車軸、輪轂及牽引柄，保留廢棄但結構完整的狀態。",
      "水晶為不透明低模礦物，使用低強度發光及有限局部補光，不使用粒子或泛光。"
    ],
    "avoid": [
      "均勻圓滑倒角",
      "全場發光",
      "隨機裝飾填滿動線",
      "以漆黑掩藏未完成的岩壁"
    ]
  },
