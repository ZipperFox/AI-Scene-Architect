{
  "schema_version": "0.2",
  "id": "silent-vein-v03",
  "brief": "建立小型、低模風格的奇幻水晶礦洞，包含不規則洞穴岩壁、木製支架、不同大小的發光水晶、一輛廢棄礦車、散落礦石、入口與主要探索區域，燈光與構圖合理。",
  "scene_type": "Cutaway fantasy mining chamber",
  "style": "Faceted low-poly, continuous inward rock shoulder, quiet dark mineral ground, restrained emerald focal light",
  "purpose": "Editable game environment diorama with a clear entrance and exploration route",
  "seed": 37,
  "art_direction": {
    "mood": [
      "幽靜",
      "粗獷",
      "微光"
    ],
    "focal_point": "入口支架作前景框，偏左軌道收束視線；晶簇偏右後方形成不對稱焦點，中央探索區留白。",
    "palette_rationale": "我選低飽和藍灰岩體、乾燥棕木與局部翡翠光；暖光只點出人工痕跡，保留清楚的中間調與接觸陰影。",
    "assumptions": [
      "採用可檢視的剖面洞穴，前側與上方開放，以便遊戲鏡頭與俯視檢查；不是封閉的整座地下山體。",
      "範圍約 12×12 公尺，洞壁最高 4.4 公尺，人物參考通行高度 1.9 公尺。",
      "礦車留有空心料斗、四輪、車軸、輪轂及牽引柄，保留廢棄但結構完整的狀態。",
      "水晶為不透明低模礦物，使用低強度發光及有限局部補光，不使用粒子或泛光。",
      "Reference Scout：木樑支撐用途有史料支持，截面與承載力未驗證；本案尺寸屬遊戲設計假設。",
      "幻想作品可以提供世界觀與功能呼應的靈感；本案晶體光與構圖是 AI 自主美感提案，不宣稱植物能量或礦物自發光是現實事實。"
    ],
    "avoid": [
      "均勻圓滑倒角",
      "全場發光",
      "隨機裝飾填滿動線",
      "以漆黑掩藏未完成的岩壁"
    ]
  },
