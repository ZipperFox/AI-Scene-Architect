{
  "schema_version": "0.2",
  "id": "woodwork-shop",
  "brief": "建立小型開放剖面的低模木工作坊：工作桌、長凳、木箱、木製柱樑與手動繩索絞盤。保留中央走道，暖木色配灰白牆，日光從開放前側照入，沒有水晶或礦洞。",
  "scene_type": "Open-front carpentry workshop",
  "style": "Low-poly utilitarian timber workshop, warm daylight, no fantasy glow",
  "purpose": "Second independently planned reuse test with furniture, structure and hand machinery",
  "seed": 73,
  "art_direction": {
    "mood": [
      "溫暖",
      "實用",
      "安靜"
    ],
    "focal_point": "工作桌作主要量體，較低長凳承接前景，絞盤在右側形成次焦點；左側疊箱較密，中央保持安靜。",
    "palette_rationale": "我選蜂蜜棕木、灰白牆與深鐵灰；從開放前側引入偏暖的大面柔光，讓材質靠明度與粗糙度區分，不靠每件物品不同顏色。",
    "assumptions": [
      "6×5 公尺開放前側與屋頂的剖面工作坊。",
      "家具與機械保持可辨識的構件和實際支撐。",
      "Reference Scout：分板檯面、四腳與下方橫撐是本案選擇，非宣稱所有工作檯必須如此；夾具與絞盤細節保留未驗證狀態。"
    ],
    "avoid": [
      "水晶與發光",
      "全表面同樣倒角",
      "塞滿中央動線"
    ]
  },
